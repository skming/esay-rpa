{
  "name": "easy-rpa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "backend:dev": "cd backend && .venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8765 --reload",
    "backend:test": "cd backend && uv run pytest",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && eslint . && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0",
    "electron:dev": "concurrently -k \"pnpm dev\" \"wait-on tcp:19174 && electron .\"",
    "stack:dev": "concurrently -k \"pnpm backend:dev\" \"pnpm dev\" \"wait-on tcp:19174 tcp:8765 && electron .\"",
    "version:bump": "node tools/bump-version.cjs",
    "icons:generate": "python3 tools/generate_app_icons.py",
    "electron:clean": "node tools/clean.cjs",
    "backend:bundle:prepare": "node tools/prepare_backend_bundle.cjs",
    "backend:bundle:verify": "node tools/verify_backend_bundle.cjs",
    "electron:pack": "node tools/dist-mac.cjs --dir",
    "electron:dist": "node tools/dist-mac.cjs",
    "electron:dist:win": "node tools/dist-other.cjs --win",
    "electron:dist:linux": "node tools/dist-other.cjs --linux",
    "electron:dist:signed": "RPA_RELEASE_SIGN=1 node tools/dist-mac.cjs",
    "backend:lint": "cd backend && uv run ruff check app",
    "lint": "eslint ."
  },
  "main": "electron/main.cjs",
  "dependencies": {
    "@shadcn/react": "^0.3.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@silurus/ooxml": "^0.80.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.1.0",
    "@xyflow/react": "^12.11.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.5",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "lucide-react": "^1.34.0",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-json-view-lite": "^2.5.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0",
    "zustand": "^5.0.15"
  }
}
