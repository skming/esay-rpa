{
  "model": "gpt-5.5",
  "scenario": "gen_table_to_excel",
  "reply": "",
  "calls": [
    {
      "name": "inspect_page",
      "args": {
        "url": "https://example.com/list",
        "wait_selector": "table, [role=grid], main"
      }
    },
    {
      "name": "list_node_types",
      "args": {}
    },
    {
      "name": "create_flow",
      "args": {
        "name": "导出列表表格到 Excel",
        "description": "打开列表页，提取表格数据并导出为 Excel 文件。",
        "input_variables": [],
        "nodes": [
          {
            "id": "start",
            "type": "start",
            "title": "开始",
            "kind": "control",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 100
            },
            "description": "开始执行流程"
          },
          {
            "id": "n1_open_list",
            "type": "browser.open",
            "title": "打开列表页",
            "kind": "browser",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 220
            },
            "targetUrl": "https://example.com/list",
            "delayMs": 2000,
            "description": "打开 https://example.com/list"
          },
          {
            "id": "n2_wait_table",
            "type": "browser.wait",
            "title": "等待表格加载",
            "kind": "browser",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 340
            },
            "selector": ".data-table tbody tr",
            "timeoutMs": 15000,
            "description": "等待数据表格行出现"
          },
          {
            "id": "n3_extract_table",
            "type": "browser.extract",
            "title": "提取表格数据",
            "kind": "browser",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 460
            },
            "selector": ".data-table tbody tr",
            "extractMode": "table",
            "outputVariable": "table_rows",
            "description": "按表格行结构化提取名称、创建时间、状态"
          },
          {
            "id": "n4_foreach_row",
            "type": "control.foreach",
            "title": "遍历表格行",
            "kind": "control",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 580
            },
            "itemsVariable": "table_rows",
            "itemVariable": "table_row",
            "description": "逐行写入 Excel"
          },
          {
            "id": "n5_add_excel_row",
            "type": "excel.addrow",
            "title": "追加 Excel 行",
            "kind": "excel",
            "status": "pending",
            "position": {
              "x": 320,
              "y": 700
            },
            "path": "${var.output_dir}/list_${var.run_timestamp}.xlsx",
            "sheetName": "列表数据",
            "rowData": "${var.table_row}",
            "description": "把当前表格行追加到 Excel"
          },
          {
            "id": "n6_save_excel",
            "type": "excel.save",
            "title": "保存 Excel 文件",
            "kind": "excel",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 820
            },
            "path": "${var.output_dir}/list_${var.run_timestamp}.xlsx",
            "description": "保存带时间戳的 Excel 文件"
          },
          {
            "id": "end",
            "type": "end",
            "title": "结束",
            "kind": "control",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 940
            },
            "description": "流程结束"
          }
        ],
        "edges": [
          {
            "id": "e_start_n1_open_list",
            "source": "start",
            "target": "n1_open_list"
          },
          {
            "id": "e_n1_open_list_n2_wait_table",
            "source": "n1_open_list",
            "target": "n2_wait_table"
          },
          {
            "id": "e_n2_wait_table_n3_extract_table",
            "source": "n2_wait_table",
            "target": "n3_extract_table"
          },
          {
            "id": "e_n3_extract_table_n4_foreach_row",
            "source": "n3_extract_table",
            "target": "n4_foreach_row"
          },
          {
            "id": "e_n4_foreach_row_n5_add_excel_row",
            "source": "n4_foreach_row",
            "target": "n5_add_excel_row",
            "label": "body"
          },
          {
            "id": "e_n4_foreach_row_n6_save_excel",
            "source": "n4_foreach_row",
            "target": "n6_save_excel",
            "label": "exit"
          },
          {
            "id": "e_n5_add_excel_row_n4_foreach_row",
            "source": "n5_add_excel_row",
            "target": "n4_foreach_row"
          },
          {
            "id": "e_n6_save_excel_end",
            "source": "n6_save_excel",
            "target": "end"
          }
        ]
      }
    }
  ]
}