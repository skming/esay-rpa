{
  "model": "gpt-5.5",
  "scenario": "gen_paginated_scrape",
  "reply": "",
  "calls": [
    {
      "name": "inspect_page",
      "args": {
        "url": "https://example.com/list",
        "wait_selector": "table, [role=grid], main"
      }
    },
    {
      "name": "inspect_page",
      "args": {
        "url": "https://example.com/list",
        "wait_selector": ".data-table tbody tr, .pagination, .el-pagination, button"
      }
    },
    {
      "name": "inspect_page",
      "args": {
        "url": "https://example.com/list",
        "wait_selector": ".data-table tbody tr"
      }
    },
    {
      "name": "create_flow",
      "args": {
        "name": "分页表格抓取为 JSON",
        "description": "打开列表页，逐页抓取表格数据并保存为 JSON。",
        "input_variables": [],
        "nodes": [
          {
            "id": "start",
            "type": "start",
            "title": "开始",
            "kind": "control",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 100
            },
            "description": "流程开始"
          },
          {
            "id": "n1_open",
            "type": "browser.open",
            "title": "打开列表页",
            "kind": "browser",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 200
            },
            "targetUrl": "https://example.com/list",
            "description": "打开 https://example.com/list"
          },
          {
            "id": "n2_wait_table",
            "type": "browser.wait",
            "title": "等待表格加载",
            "kind": "browser",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 300
            },
            "selector": ".data-table tbody tr",
            "timeoutMs": 15000,
            "description": "等待数据表格行出现"
          },
          {
            "id": "n3_paginate_extract",
            "type": "browser.paginateNext",
            "title": "翻页抓取表格",
            "kind": "browser",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 400
            },
            "selector": ".el-pagination button.btn-next, button[aria-label='下一页'], button:has-text('下一页'), button:has-text('>')",
            "targetSelector": ".data-table tbody tr",
            "extractMode": "table",
            "outputVariable": "table_data",
            "countVariable": "table_row_count",
            "pageCountVariable": "table_page_count",
            "maxIterations": 100,
            "delayMs": 800,
            "description": "从当前页开始逐页提取 .data-table tbody tr，下一页按钮禁用或不存在时停止"
          },
          {
            "id": "n4_write_json",
            "type": "file.write",
            "title": "保存 JSON",
            "kind": "file",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 500
            },
            "path": "${var.output_prefix}.json",
            "content": "${var.table_data}",
            "description": "保存抓取到的全部表格数据"
          },
          {
            "id": "end",
            "type": "end",
            "title": "结束",
            "kind": "control",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 600
            },
            "description": "流程结束"
          }
        ],
        "edges": [
          {
            "id": "e_start_n1_open",
            "source": "start",
            "target": "n1_open"
          },
          {
            "id": "e_n1_open_n2_wait_table",
            "source": "n1_open",
            "target": "n2_wait_table"
          },
          {
            "id": "e_n2_wait_table_n3_paginate_extract",
            "source": "n2_wait_table",
            "target": "n3_paginate_extract"
          },
          {
            "id": "e_n3_paginate_extract_n4_write_json",
            "source": "n3_paginate_extract",
            "target": "n4_write_json"
          },
          {
            "id": "e_n4_write_json_end",
            "source": "n4_write_json",
            "target": "end"
          }
        ]
      }
    }
  ]
}