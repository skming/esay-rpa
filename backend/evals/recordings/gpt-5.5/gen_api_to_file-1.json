{
  "model": "gpt-5.5",
  "scenario": "gen_api_to_file",
  "reply": "",
  "calls": [
    {
      "name": "inspect_page",
      "args": {
        "url": "https://api.example.com/orders",
        "wait_selector": "body"
      }
    },
    {
      "name": "list_node_types",
      "args": {}
    },
    {
      "name": "create_flow",
      "args": {
        "name": "订单接口抓取到本地文件",
        "description": "调用订单 GET 接口，解析返回 JSON，并将订单逐条写入本地 JSONL 文件。",
        "input_variables": [],
        "nodes": [
          {
            "id": "start",
            "type": "start",
            "title": "开始",
            "kind": "control",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 100
            },
            "description": "启动流程"
          },
          {
            "id": "n1_request_orders",
            "type": "http.request",
            "title": "请求订单接口",
            "kind": "http",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 220
            },
            "description": "GET https://api.example.com/orders → orders_response",
            "url": "https://api.example.com/orders",
            "method": "GET",
            "outputVariable": "orders_response"
          },
          {
            "id": "n2_parse_orders",
            "type": "data.json.parse",
            "title": "解析订单 JSON",
            "kind": "data",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 340
            },
            "description": "解析 orders_response → orders_payload",
            "inputVariable": "orders_response",
            "outputVariable": "orders_payload"
          },
          {
            "id": "n3_write_orders",
            "type": "script.python",
            "title": "逐条写入本地文件",
            "kind": "script",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 460
            },
            "description": "从返回体中识别订单列表，逐条写入 JSONL 文件 → orders_file",
            "timeoutMs": 10000,
            "outputVariable": "orders_file",
            "code": "import json, os\n\n_vars = json.loads(os.environ.get('RPA_VARIABLES_JSON', '{}'))\npayload = _vars.get('orders_payload')\n\nif isinstance(payload, list):\n    orders = payload\nelif isinstance(payload, dict):\n    for key in ('orders', 'data', 'items', 'list', 'results'):\n        value = payload.get(key)\n        if isinstance(value, list):\n            orders = value\n            break\n    else:\n        raise SystemExit('接口返回 JSON 中未找到订单列表字段，已尝试 orders/data/items/list/results')\nelse:\n    raise SystemExit(f'接口返回类型不支持：{type(payload).__name__}')\n\noutput_dir = _vars.get('output_dir', 'runs/orders')\nrun_timestamp = _vars.get('run_timestamp', 'run')\nos.makedirs(output_dir, exist_ok=True)\npath = os.path.join(output_dir, f'orders_{run_timestamp}.jsonl')\n\nwith open(path, 'w', encoding='utf-8') as f:\n    for order in orders:\n        f.write(json.dumps(order, ensure_ascii=False) + '\\n')\n\nprint(path)\n"
          },
          {
            "id": "end",
            "type": "end",
            "title": "结束",
            "kind": "control",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 580
            },
            "description": "流程结束"
          }
        ],
        "edges": [
          {
            "id": "e_start_n1_request_orders",
            "source": "start",
            "target": "n1_request_orders"
          },
          {
            "id": "e_n1_request_orders_n2_parse_orders",
            "source": "n1_request_orders",
            "target": "n2_parse_orders"
          },
          {
            "id": "e_n2_parse_orders_n3_write_orders",
            "source": "n2_parse_orders",
            "target": "n3_write_orders"
          },
          {
            "id": "e_n3_write_orders_end",
            "source": "n3_write_orders",
            "target": "end"
          }
        ]
      }
    }
  ]
}