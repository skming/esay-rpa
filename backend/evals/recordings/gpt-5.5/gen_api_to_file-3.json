            "target": "n2_parse_orders"
          },
          {
            "id": "e_n2_parse_orders_n3_write_orders",
            "source": "n2_parse_orders",
            "target": "n3_write_orders"
          },
          {
            "id": "e_n3_write_orders_end",
            "source": "n3_write_orders",
            "target": "end"
          }
        ],
        "input_variables": []
      }
    }
  ]
