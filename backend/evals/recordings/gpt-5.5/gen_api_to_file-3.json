{
  "model": "gpt-5.5",
  "scenario": "gen_api_to_file",
  "reply": "",
  "calls": [
    {
      "name": "inspect_page",
      "args": {
        "url": "https://api.example.com/orders",
        "wait_selector": "body"
      }
    },
    {
      "name": "list_node_types",
      "args": {}
    },
    {
      "name": "create_flow",
      "args": {
        "name": "订单接口抓取到本地文件",
        "description": "调用订单 GET 接口并把返回 JSON 的订单列表写成本地 JSONL 文件",
        "nodes": [
          {
            "id": "start",
            "type": "start",
            "title": "开始",
            "kind": "control",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 100
            },
            "description": "开始执行订单接口抓取"
          },
          {
            "id": "n1_request_orders",
            "type": "http.request",
            "title": "请求订单接口",
            "kind": "http",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 220
            },
            "description": "GET https://api.example.com/orders → orders_response",
            "url": "https://api.example.com/orders",
            "method": "GET",
            "outputVariable": "orders_response"
          },
          {
            "id": "n2_parse_orders",
            "type": "data.json.parse",
            "title": "解析订单 JSON",
            "kind": "data",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 340
            },
            "description": "解析响应体 → orders_json",
            "inputVariable": "orders_response",
            "outputVariable": "orders_json"
          },
          {
            "id": "n3_write_orders",
            "type": "script.python",
            "title": "写入订单文件",
            "kind": "script",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 460
            },
            "description": "将每条订单逐行写入 JSONL 文件并输出产物路径",
            "outputVariable": "orders_file",
            "code": "import json, os\n_vars = json.loads(os.environ.get('RPA_VARIABLES_JSON', '{}'))\norders_json = _vars.get('orders_json', [])\n\nif isinstance(orders_json, dict):\n    for key in ('orders', 'data', 'items', 'list', 'results'):\n        value = orders_json.get(key)\n        if isinstance(value, list):\n            orders = value\n            break\n    else:\n        orders = [orders_json]\nelif isinstance(orders_json, list):\n    orders = orders_json\nelse:\n    raise SystemExit('接口返回 JSON 不是对象或数组，无法写入订单列表')\n\noutput_dir = _vars.get('output_dir', '.')\nrun_timestamp = _vars.get('run_timestamp', 'run')\nos.makedirs(output_dir, exist_ok=True)\npath = os.path.join(output_dir, f'orders_{run_timestamp}.jsonl')\nwith open(path, 'w', encoding='utf-8') as f:\n    for order in orders:\n        f.write(json.dumps(order, ensure_ascii=False) + '\\n')\nprint(path)\n"
          },
          {
            "id": "end",
            "type": "end",
            "title": "结束",
            "kind": "control",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 580
            },
            "description": "订单文件写入完成"
          }
        ],
        "edges": [
