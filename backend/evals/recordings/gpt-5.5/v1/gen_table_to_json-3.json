{
  "model": "gpt-5.5",
  "scenario": "gen_table_to_json",
  "reply": "",
  "calls": [
    {
      "name": "inspect_page",
      "args": {
        "url": "https://example.com/list",
        "wait_selector": "table, [role=grid], main"
      }
    },
    {
      "name": "create_flow",
      "args": {
        "name": "抓取列表表格到 JSON",
        "description": "打开列表页，提取表格数据并保存为 JSON。",
        "input_variables": [],
        "nodes": [
          {
            "id": "start",
            "type": "start",
            "title": "开始",
            "kind": "control",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 100
            },
            "description": "开始流程"
          },
          {
            "id": "n1_open_list",
            "type": "browser.open",
            "title": "打开列表页",
            "kind": "browser",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 220
            },
            "targetUrl": "https://example.com/list",
            "description": "打开 https://example.com/list"
          },
          {
            "id": "n2_wait_table",
            "type": "browser.wait",
            "title": "等待表格加载",
            "kind": "browser",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 340
            },
            "selector": ".data-table tbody tr",
            "timeoutMs": 15000,
            "description": "等待表格数据行出现"
          },
          {
            "id": "n3_extract_table",
            "type": "browser.extract",
            "title": "提取表格数据",
            "kind": "browser",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 460
            },
            "selector": ".data-table tbody tr",
            "extractMode": "table",
            "outputVariable": "table_data",
            "description": "按表格行结构化提取 → table_data"
          },
          {
            "id": "n4_write_json",
            "type": "file.write",
            "title": "保存 JSON",
            "kind": "file",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 580
            },
            "path": "${var.output_prefix}.json",
            "content": "${var.table_data}",
            "description": "保存提取结果到本次运行目录"
          },
          {
            "id": "end",
            "type": "end",
            "title": "结束",
            "kind": "control",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 700
            },
            "description": "结束流程"
          }
        ],
        "edges": [
          {
            "id": "e_start_n1_open_list",
            "source": "start",
            "target": "n1_open_list"
          },
          {
            "id": "e_n1_open_list_n2_wait_table",
            "source": "n1_open_list",
            "target": "n2_wait_table"
          },
          {
            "id": "e_n2_wait_table_n3_extract_table",
            "source": "n2_wait_table",
            "target": "n3_extract_table"
          },
          {
            "id": "e_n3_extract_table_n4_write_json",
            "source": "n3_extract_table",
            "target": "n4_write_json"
          },
          {
            "id": "e_n4_write_json_end",
            "source": "n4_write_json",
            "target": "end"
          }
        ]
      }
    }
  ]
}