{
  "model": "gpt-5.5",
  "prompt_version": "v2",
  "scenario": "gen_login_then_navigate",
  "reply": "",
  "calls": [
    {
      "name": "inspect_page",
      "args": {
        "url": "https://example.com/admin",
        "wait_selector": "input[type='password'], nav, main, table, [role=grid]"
      }
    },
    {
      "name": "create_flow",
      "args": {
        "name": "订单列表抓取",
        "description": "登录后台后抓取订单列表表格并保存为 JSON",
        "input_variables": [
          {
            "name": "username",
            "type": "String",
            "value": "demo_user",
            "category": "credential"
          },
          {
            "name": "password",
            "type": "String",
            "value": "demo_pass",
            "category": "credential",
            "sensitive": true
          }
        ],
        "nodes": [
          {
            "id": "start",
            "type": "start",
            "title": "开始",
            "kind": "control",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 100
            },
            "description": "开始执行流程"
          },
          {
            "id": "n1",
            "type": "browser.ensureLogin",
            "title": "判断登录态",
            "kind": "browser",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 220
            },
            "description": "打开后台并判断是否出现登录表单 → login_status",
            "targetUrl": "https://example.com/admin",
            "selector": "table, .data-table tbody tr",
            "targetSelector": "input[type='password']",
            "firstValueVariable": "login_status",
            "timeoutMs": 15000
          },
          {
            "id": "n2",
            "type": "control.condition",
            "title": "是否需要登录",
            "kind": "control",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 340
            },
            "description": "login_status == 'login_required' → 执行登录",
            "inputValue": "login_status == 'login_required'"
          },
          {
            "id": "n3",
            "type": "browser.fill",
            "title": "填写账号",
            "kind": "browser",
            "status": "pending",
            "position": {
              "x": 320,
              "y": 460
            },
            "description": "填写 ${var.username}",
            "selector": "input[placeholder='请输入用户名']",
            "inputValue": "${var.username}",
            "timeoutMs": 10000
          },
          {
            "id": "n4",
            "type": "browser.fill",
            "title": "填写密码",
            "kind": "browser",
            "status": "pending",
            "position": {
              "x": 320,
              "y": 580
            },
            "description": "填写 ${var.password}",
            "selector": "input[type='password']",
            "inputValue": "${var.password}",
            "timeoutMs": 10000
          },
          {
            "id": "n5",
            "type": "browser.click",
            "title": "点击登录",
            "kind": "browser",
            "status": "pending",
            "position": {
              "x": 320,
              "y": 700
            },
            "description": "提交登录表单",
            "selector": "button:has-text('登录')",
            "anchorText": "登录",
            "timeoutMs": 10000,
            "delayMs": 1500
          },
          {
            "id": "n6",
            "type": "browser.wait",
            "title": "等待后台表格",
            "kind": "browser",
            "status": "pending",
            "position": {
              "x": 320,
              "y": 820
            },
            "description": "等待登录后订单列表表格出现",
            "selector": "table, .data-table tbody tr",
            "timeoutMs": 15000
          },
          {
            "id": "n7",
            "type": "browser.open",
            "title": "打开订单列表页",
            "kind": "browser",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 940
            },
            "description": "合流后打开后台订单列表页面",
            "targetUrl": "https://example.com/admin",
            "delayMs": 1000
          },
          {
            "id": "n8",
            "type": "browser.wait",
            "title": "等待订单表格",
            "kind": "browser",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 1060
            },
            "description": "等待订单列表表格渲染完成",
            "selector": "table, .data-table tbody tr",
            "timeoutMs": 15000
          },
          {
            "id": "n9",
            "type": "browser.extract",
            "title": "提取订单表格",
            "kind": "browser",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 1180
            },
            "description": "按表格模式提取订单列表 → orders",
            "selector": ".data-table tbody tr",
            "extractMode": "table",
            "outputVariable": "orders",
            "countVariable": "order_count",
            "timeoutMs": 15000
          },
          {
            "id": "n10",
            "type": "file.write",
            "title": "保存 JSON",
            "kind": "file",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 1300
            },
            "description": "保存订单列表到本次运行目录",
            "path": "${var.output_prefix}.json",
            "content": "${var.orders}"
          },
          {
            "id": "end",
            "type": "end",
            "title": "结束",
            "kind": "control",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 1420
            },
            "description": "流程结束"
          }
        ],
        "edges": [
          {
            "id": "e_start_n1",
            "source": "start",
            "target": "n1"
          },
          {
            "id": "e_n1_n2",
            "source": "n1",
            "target": "n2"
          },
          {
            "id": "e_n2_n3",
            "source": "n2",
            "target": "n3",
            "label": "true"
          },
          {
            "id": "e_n2_n7",
            "source": "n2",
            "target": "n7",
            "label": "false"
          },
          {
            "id": "e_n3_n4",
            "source": "n3",
            "target": "n4"
          },
          {
            "id": "e_n4_n5",
            "source": "n4",
            "target": "n5"
          },
          {
            "id": "e_n5_n6",
            "source": "n5",
            "target": "n6"
          },
          {
            "id": "e_n6_n7",
            "source": "n6",
            "target": "n7"
          },
          {
            "id": "e_n7_n8",
            "source": "n7",
            "target": "n8"
          },
          {
            "id": "e_n8_n9",
            "source": "n8",
            "target": "n9"
          },
          {
            "id": "e_n9_n10",
            "source": "n9",
            "target": "n10"
          },
          {
            "id": "e_n10_end",
            "source": "n10",
            "target": "end"
          }
        ]
      }
    }
  ],
  "guard_hits": []
}