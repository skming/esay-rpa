{
  "model": "gpt-5.5",
  "prompt_version": "v2",
  "scenario": "gen_paginated_scrape",
  "reply": "",
  "calls": [
    {
      "name": "inspect_page",
      "args": {
        "url": "https://example.com/list",
        "wait_selector": "table, [role=grid], main"
      }
    },
    {
      "name": "list_node_types",
      "args": {}
    },
    {
      "name": "inspect_page",
      "args": {
        "url": "https://example.com/list",
        "wait_selector": ".data-table tbody tr, .el-pagination, table"
      }
    },
    {
      "name": "create_flow",
      "args": {
        "name": "分页表格抓取为 JSON",
        "description": "打开列表页，按分页累计提取表格所有行并保存 JSON。",
        "nodes": [
          {
            "id": "start",
            "type": "start",
            "title": "开始",
            "kind": "control",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 100
            },
            "description": "流程开始"
          },
          {
            "id": "n1_open",
            "type": "browser.open",
            "title": "打开列表页",
            "kind": "browser",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 200
            },
            "targetUrl": "https://example.com/list",
            "delayMs": 2000,
            "description": "打开 https://example.com/list"
          },
          {
            "id": "n2_wait",
            "type": "browser.wait",
            "title": "等待表格行",
            "kind": "browser",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 300
            },
            "selector": ".data-table tbody tr",
            "timeoutMs": 15000,
            "description": "等待表格数据行出现"
          },
          {
            "id": "n3_paginate",
            "type": "browser.paginateNext",
            "title": "翻页提取表格",
            "kind": "browser",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 400
            },
            "selector": "button:has-text('下一页')",
            "targetSelector": ".data-table tbody tr",
            "extractMode": "table",
            "outputVariable": "table_rows",
            "pageCountVariable": "page_count",
            "maxIterations": 50,
            "delayMs": 1000,
            "description": "逐页点击下一页并累计提取 .data-table tbody tr"
          },
          {
            "id": "n4_write",
            "type": "file.write",
            "title": "保存 JSON",
            "kind": "file",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 500
            },
            "path": "${var.output_prefix}.json",
            "content": "${var.table_rows}",
            "description": "保存抓取结果到本次运行目录 JSON 文件"
          },
          {
            "id": "end",
            "type": "end",
            "title": "结束",
            "kind": "control",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 600
            },
            "description": "流程结束"
          }
        ],
        "edges": [
          {
            "id": "e_start_n1_open",
            "source": "start",
            "target": "n1_open"
          },
          {
            "id": "e_n1_open_n2_wait",
            "source": "n1_open",
            "target": "n2_wait"
          },
          {
            "id": "e_n2_wait_n3_paginate",
            "source": "n2_wait",
            "target": "n3_paginate"
          },
          {
            "id": "e_n3_paginate_n4_write",
            "source": "n3_paginate",
            "target": "n4_write"
          },
          {
            "id": "e_n4_write_end",
            "source": "n4_write",
            "target": "end"
          }
        ],
        "input_variables": []
      }
    }
  ],
  "guard_hits": []
}