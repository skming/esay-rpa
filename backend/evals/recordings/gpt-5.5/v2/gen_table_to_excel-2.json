{
  "model": "gpt-5.5",
  "prompt_version": "v2",
  "scenario": "gen_table_to_excel",
  "reply": "",
  "calls": [
    {
      "name": "inspect_page",
      "args": {
        "url": "https://example.com/list",
        "wait_selector": "table, [role=grid], main"
      }
    },
    {
      "name": "list_node_types",
      "args": {}
    },
    {
      "name": "create_flow",
      "args": {
        "name": "表格数据导出 Excel",
        "description": "打开列表页，提取表格数据并导出为 Excel 文件。",
        "nodes": [
          {
            "id": "start",
            "type": "start",
            "title": "开始",
            "kind": "control",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 100
            },
            "description": "开始执行流程"
          },
          {
            "id": "n1_open",
            "type": "browser.open",
            "title": "打开列表页",
            "kind": "browser",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 220
            },
            "targetUrl": "https://example.com/list",
            "delayMs": 2000,
            "description": "打开 https://example.com/list"
          },
          {
            "id": "n2_wait",
            "type": "browser.wait",
            "title": "等待表格加载",
            "kind": "browser",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 340
            },
            "selector": ".data-table tbody tr",
            "timeoutMs": 15000,
            "description": "等待表格数据行出现"
          },
          {
            "id": "n3_extract",
            "type": "browser.extract",
            "title": "提取表格数据",
            "kind": "browser",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 460
            },
            "selector": ".data-table tbody tr",
            "extractMode": "table",
            "outputVariable": "table_rows",
            "countVariable": "table_row_count",
            "description": "按表格模式提取数据行 → table_rows"
          },
          {
            "id": "n4_foreach",
            "type": "control.foreach",
            "title": "逐行写入 Excel",
            "kind": "control",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 580
            },
            "itemsVariable": "table_rows",
            "itemVariable": "table_row",
            "description": "遍历 table_rows 写入 Excel"
          },
          {
            "id": "n5_addrow",
            "type": "excel.addrow",
            "title": "追加 Excel 行",
            "kind": "excel",
            "status": "pending",
            "position": {
              "x": 320,
              "y": 700
            },
            "path": "${var.output_prefix}.xlsx",
            "sheetName": "Sheet1",
            "rowData": "${var.table_row}",
            "description": "把当前表格行追加到 Excel"
          },
          {
            "id": "n6_save",
            "type": "excel.save",
            "title": "保存 Excel 文件",
            "kind": "excel",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 820
            },
            "path": "${var.output_prefix}.xlsx",
            "description": "保存 Excel 到本次运行目录"
          },
          {
            "id": "end",
            "type": "end",
            "title": "结束",
            "kind": "control",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 940
            },
            "description": "流程结束"
          }
        ],
        "edges": [
          {
            "id": "e_start_n1_open",
            "source": "start",
            "target": "n1_open"
          },
          {
            "id": "e_n1_open_n2_wait",
            "source": "n1_open",
            "target": "n2_wait"
          },
          {
            "id": "e_n2_wait_n3_extract",
            "source": "n2_wait",
            "target": "n3_extract"
          },
          {
            "id": "e_n3_extract_n4_foreach",
            "source": "n3_extract",
            "target": "n4_foreach"
          },
          {
            "id": "e_n4_foreach_n5_addrow",
            "source": "n4_foreach",
            "target": "n5_addrow",
            "label": "body"
          },
          {
            "id": "e_n4_foreach_n6_save",
            "source": "n4_foreach",
            "target": "n6_save",
            "label": "exit"
          },
          {
            "id": "e_n5_addrow_n4_foreach",
            "source": "n5_addrow",
            "target": "n4_foreach"
          },
          {
            "id": "e_n6_save_end",
            "source": "n6_save",
            "target": "end"
          }
        ],
        "input_variables": []
      }
    }
  ],
  "guard_hits": []
}