{
  "model": "gpt-5.5",
  "prompt_version": "v2",
  "scenario": "gen_login_then_navigate",
  "reply": "",
  "calls": [
    {
      "name": "inspect_page",
      "args": {
        "url": "https://example.com/admin",
        "wait_selector": "input[type='password'], table, [role=grid], nav, main"
      }
    },
    {
      "name": "create_flow",
      "args": {
        "name": "订单列表抓取",
        "description": "判断登录态后登录后台，抓取订单列表表格并保存为 JSON。",
        "input_variables": [
          {
            "name": "username",
            "type": "String",
            "value": "demo_user",
            "category": "credential"
          },
          {
            "name": "password",
            "type": "String",
            "value": "demo_pass",
            "category": "credential",
            "sensitive": true
          }
        ],
        "nodes": [
          {
            "id": "start",
            "type": "start",
            "title": "开始",
            "kind": "control",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 100
            },
            "description": "流程开始"
          },
          {
            "id": "n1_ensure_login",
            "type": "browser.ensureLogin",
            "title": "判断登录态",
            "kind": "browser",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 200
            },
            "description": "访问后台并判断是否需要登录 → login_status",
            "targetUrl": "https://example.com/admin",
            "selector": "table, .data-table",
            "targetSelector": "input[type='password']",
            "firstValueVariable": "login_status",
            "delayMs": 1500
          },
          {
            "id": "n2_need_login",
            "type": "control.condition",
            "title": "是否需要登录",
            "kind": "control",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 300
            },
            "description": "login_required → 执行登录",
            "inputValue": "login_status == 'login_required'"
          },
          {
            "id": "n3_fill_username",
            "type": "browser.fill",
            "title": "填写账号",
            "kind": "browser",
            "status": "pending",
            "position": {
              "x": 320,
              "y": 400
            },
            "description": "填写后台登录账号",
            "selector": "input[placeholder='请输入用户名']",
            "inputValue": "${var.username}",
            "delayMs": 300
          },
          {
            "id": "n4_fill_password",
            "type": "browser.fill",
            "title": "填写密码",
            "kind": "browser",
            "status": "pending",
            "position": {
              "x": 320,
              "y": 500
            },
            "description": "填写后台登录密码",
            "selector": "input[type='password']",
            "inputValue": "${var.password}",
            "delayMs": 300
          },
          {
            "id": "n5_click_login",
            "type": "browser.click",
            "title": "点击登录",
            "kind": "browser",
            "status": "pending",
            "position": {
              "x": 320,
              "y": 600
            },
            "description": "提交登录表单",
            "selector": "button:has-text('登录')",
            "anchorText": "登录",
            "delayMs": 1500
          },
          {
            "id": "n6_wait_table_after_login",
            "type": "browser.wait",
            "title": "等待订单表格",
            "kind": "browser",
            "status": "pending",
            "position": {
              "x": 320,
              "y": 700
            },
            "description": "登录后等待订单列表表格出现",
            "selector": "table, .data-table",
            "timeoutMs": 15000
          },
          {
            "id": "n7_open_orders",
            "type": "browser.open",
            "title": "打开订单列表",
            "kind": "browser",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 800
            },
            "description": "进入后台订单列表页面",
            "targetUrl": "https://example.com/admin",
            "delayMs": 1500
          },
          {
            "id": "n8_wait_orders",
            "type": "browser.wait",
            "title": "等待列表加载",
            "kind": "browser",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 900
            },
            "description": "等待订单列表表格加载完成",
            "selector": "table, .data-table",
            "timeoutMs": 15000
          },
          {
            "id": "n9_extract_orders",
            "type": "browser.extract",
            "title": "提取订单表格",
            "kind": "browser",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 1000
            },
            "description": "按表格模式提取订单列表 → orders",
            "selector": ".data-table tbody tr",
            "extractMode": "table",
            "outputVariable": "orders",
            "countVariable": "order_count",
            "timeoutMs": 15000
          },
          {
            "id": "n10_write_json",
            "type": "file.write",
            "title": "保存 JSON",
            "kind": "file",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 1100
            },
            "description": "保存订单列表 JSON 到本次运行目录",
            "path": "${var.output_prefix}.json",
            "content": "${var.orders}"
          },
          {
            "id": "end",
            "type": "end",
            "title": "结束",
            "kind": "control",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 1200
            },
            "description": "流程结束"
          }
        ],
        "edges": [
          {
            "id": "e_start_n1_ensure_login",
            "source": "start",
            "target": "n1_ensure_login"
          },
          {
            "id": "e_n1_ensure_login_n2_need_login",
            "source": "n1_ensure_login",
            "target": "n2_need_login"
          },
          {
            "id": "e_n2_need_login_n3_fill_username",
            "source": "n2_need_login",
            "target": "n3_fill_username",
            "label": "true"
          },
          {
            "id": "e_n3_fill_username_n4_fill_password",
            "source": "n3_fill_username",
            "target": "n4_fill_password"
          },
          {
            "id": "e_n4_fill_password_n5_click_login",
            "source": "n4_fill_password",
            "target": "n5_click_login"
          },
          {
            "id": "e_n5_click_login_n6_wait_table_after_login",
            "source": "n5_click_login",
            "target": "n6_wait_table_after_login"
          },
          {
            "id": "e_n6_wait_table_after_login_n7_open_orders",
            "source": "n6_wait_table_after_login",
            "target": "n7_open_orders"
          },
          {
            "id": "e_n2_need_login_n7_open_orders",
            "source": "n2_need_login",
            "target": "n7_open_orders",
            "label": "false"
          },
          {
            "id": "e_n7_open_orders_n8_wait_orders",
            "source": "n7_open_orders",
            "target": "n8_wait_orders"
          },
          {
            "id": "e_n8_wait_orders_n9_extract_orders",
            "source": "n8_wait_orders",
            "target": "n9_extract_orders"
          },
          {
            "id": "e_n9_extract_orders_n10_write_json",
            "source": "n9_extract_orders",
            "target": "n10_write_json"
          },
          {
            "id": "e_n10_write_json_end",
            "source": "n10_write_json",
            "target": "end"
          }
        ]
      }
    }
  ],
  "guard_hits": []
}