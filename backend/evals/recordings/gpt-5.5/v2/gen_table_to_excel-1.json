{
  "model": "gpt-5.5",
  "prompt_version": "v2",
  "scenario": "gen_table_to_excel",
  "reply": "",
  "calls": [
    {
      "name": "inspect_page",
      "args": {
        "url": "https://example.com/list",
        "wait_selector": "table, [role=grid], main"
      }
    },
    {
      "name": "list_node_types",
      "args": {}
    },
    {
      "name": "create_flow",
      "args": {
        "name": "表格数据导出 Excel",
        "description": "打开列表页，提取表格行并导出为 Excel 文件。",
        "nodes": [
          {
            "id": "start",
            "type": "start",
            "title": "开始",
            "kind": "control",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 100
            },
            "description": "启动流程"
          },
          {
            "id": "n1_open",
            "type": "browser.open",
            "title": "打开列表页",
            "kind": "browser",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 200
            },
            "description": "打开 https://example.com/list",
            "targetUrl": "https://example.com/list",
            "delayMs": 2000
          },
          {
            "id": "n2_wait_table",
            "type": "browser.wait",
            "title": "等待表格",
            "kind": "browser",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 300
            },
            "description": "等待数据表格出现",
            "selector": ".data-table tbody tr",
            "timeoutMs": 15000
          },
          {
            "id": "n3_extract_table",
            "type": "browser.extract",
            "title": "提取表格数据",
            "kind": "browser",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 400
            },
            "description": "按行提取表格 → table_rows",
            "selector": ".data-table tbody tr",
            "extractMode": "table",
            "outputVariable": "table_rows"
          },
          {
            "id": "n4_foreach",
            "type": "control.foreach",
            "title": "逐行写入",
            "kind": "control",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 500
            },
            "description": "遍历 table_rows，每行写入 Excel",
            "itemsVariable": "table_rows",
            "itemVariable": "row"
          },
          {
            "id": "n5_addrow",
            "type": "excel.addrow",
            "title": "追加 Excel 行",
            "kind": "excel",
            "status": "pending",
            "position": {
              "x": 320,
              "y": 600
            },
            "description": "把当前行追加到 Excel",
            "path": "${var.output_dir}/table_${var.run_timestamp}.xlsx",
            "sheetName": "Sheet1",
            "rowData": "${var.row}"
          },
          {
            "id": "n6_save",
            "type": "excel.save",
            "title": "保存 Excel 文件",
            "kind": "excel",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 700
            },
            "description": "保存 Excel 产物",
            "path": "${var.output_dir}/table_${var.run_timestamp}.xlsx"
          },
          {
            "id": "end",
            "type": "end",
            "title": "结束",
            "kind": "control",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 800
            },
            "description": "流程结束"
          }
        ],
        "edges": [
          {
            "id": "e_start_n1_open",
            "source": "start",
            "target": "n1_open"
          },
          {
            "id": "e_n1_open_n2_wait_table",
            "source": "n1_open",
            "target": "n2_wait_table"
          },
          {
            "id": "e_n2_wait_table_n3_extract_table",
            "source": "n2_wait_table",
            "target": "n3_extract_table"
          },
          {
            "id": "e_n3_extract_table_n4_foreach",
            "source": "n3_extract_table",
            "target": "n4_foreach"
          },
          {
            "id": "e_n4_foreach_n5_addrow",
            "source": "n4_foreach",
            "target": "n5_addrow",
            "label": "body"
          },
          {
            "id": "e_n4_foreach_n6_save",
            "source": "n4_foreach",
            "target": "n6_save",
            "label": "exit"
          },
          {
            "id": "e_n5_addrow_n4_foreach",
            "source": "n5_addrow",
            "target": "n4_foreach"
          },
          {
            "id": "e_n6_save_end",
            "source": "n6_save",
            "target": "end"
          }
        ],
        "input_variables": []
      }
    }
  ],
  "guard_hits": []
}