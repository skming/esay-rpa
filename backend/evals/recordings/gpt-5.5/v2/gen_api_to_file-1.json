            "code": "import json, os\n_vars = json.loads(os.environ.get('RPA_VARIABLES_JSON', '{}'))\nraw = _vars.get('orders_json', [])\n\nif isinstance(raw, dict):\n    for key in ('orders', 'data', 'items', 'list', 'results'):\n        if isinstance(raw.get(key), list):\n            orders = raw[key]\n            break\n    else:\n        orders = [raw]\nelif isinstance(raw, list):\n    orders = raw\nelse:\n    raise SystemExit('接口返回 JSON 不是对象或数组，无法识别订单列表')\n\nout_dir = _vars.get('output_dir') or 'runs/orders'\nos.makedirs(out_dir, exist_ok=True)\npath = os.path.join(out_dir, 'orders_%s.jsonl' % (_vars.get('run_timestamp') or 'latest'))\nwith open(path, 'w', encoding='utf-8') as f:\n    for order in orders:\n        f.write(json.dumps(order, ensure_ascii=False) + '\\n')\nprint(path)\n"
