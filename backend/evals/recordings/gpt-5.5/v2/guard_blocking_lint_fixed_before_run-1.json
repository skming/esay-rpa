{
  "model": "gpt-5.5",
  "prompt_version": "v2",
  "scenario": "guard_blocking_lint_fixed_before_run",
  "reply": "**验收通过。** 已创建并运行流程，成功抓取 `https://example.com/list` 的表格数据，审计确认输出为结构化表格数据且至少包含 1 行。\n\n本次输出变量中包含表格数据：`data`，示例记录为 `{\"名称\":\"示例\",\"状态\":\"正常\"}`。",
  "calls": [
    {
      "name": "inspect_page",
      "args": {
        "url": "https://example.com/list",
        "wait_selector": "table, [role=grid], main"
      }
    },
    {
      "name": "create_flow",
      "args": {
        "name": "抓取示例列表表格",
        "description": "抓取 https://example.com/list 页面表格并保存为 JSON",
        "input_variables": [],
        "nodes": [
          {
            "id": "start",
            "type": "start",
            "title": "开始",
            "kind": "control",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 100
            },
            "description": "开始执行流程"
          },
          {
            "id": "n1_open",
            "type": "browser.open",
            "title": "打开列表页",
            "kind": "browser",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 220
            },
            "targetUrl": "https://example.com/list",
            "description": "打开目标列表页"
          },
          {
            "id": "n2_wait_table",
            "type": "browser.wait",
            "title": "等待表格加载",
            "kind": "browser",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 340
            },
            "selector": ".data-table tbody tr",
            "timeoutMs": 15000,
            "description": "等待数据表格行出现"
          },
          {
            "id": "n3_extract_table",
            "type": "browser.extract",
            "title": "提取表格数据",
            "kind": "browser",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 460
            },
            "selector": ".data-table tbody tr",
            "extractMode": "table",
            "outputVariable": "table_data",
            "countVariable": "table_row_count",
            "description": "按表格模式提取结构化行数据 → table_data"
          },
          {
            "id": "n4_write_json",
            "type": "file.write",
            "title": "保存 JSON",
            "kind": "file",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 580
            },
            "path": "${var.output_prefix}.json",
            "content": "${var.table_data}",
            "description": "将表格数据保存为本次运行目录下的 JSON 文件"
          },
          {
            "id": "end",
            "type": "end",
            "title": "结束",
            "kind": "control",
            "status": "pending",
            "position": {
              "x": 100,
              "y": 700
            },
            "description": "流程结束"
          }
        ],
        "edges": [
          {
            "id": "e_start_n1_open",
            "source": "start",
            "target": "n1_open"
          },
          {
            "id": "e_n1_open_n2_wait_table",
            "source": "n1_open",
            "target": "n2_wait_table"
          },
          {
            "id": "e_n2_wait_table_n3_extract_table",
            "source": "n2_wait_table",
            "target": "n3_extract_table"
          },
          {
            "id": "e_n3_extract_table_n4_write_json",
            "source": "n3_extract_table",
            "target": "n4_write_json"
          },
          {
            "id": "e_n4_write_json_end",
            "source": "n4_write_json",
            "target": "end"
          }
        ]
      }
    },
    {
      "name": "validate_flow",
      "args": {
        "flow_id": "eval-flow-0001"
      }
    },
    {
      "name": "get_flow",
      "args": {
        "flow_id": "eval-flow-0001"
      }
    },
    {
      "name": "apply_node_fix",
      "args": {
        "flow_id": "eval-flow-0001",
        "node_id": "n2",
        "config_patch": {
          "selector": ".data-table tbody tr"
        }
      }
    },
    {
      "name": "validate_flow",
      "args": {
        "flow_id": "eval-flow-0001"
      }
    },
    {
      "name": "run_flow",
      "args": {
        "flow_id": "eval-flow-0001"
      }
    },
    {
      "name": "get_run_output",
      "args": {
        "task_id": "eval-task-0001"
      }
    },
    {
      "name": "assert_run_output",
      "args": {
